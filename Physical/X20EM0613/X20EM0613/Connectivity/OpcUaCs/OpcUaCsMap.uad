<?xml version="1.0" encoding="utf-8"?>
<?AutomationStudio FileVersion="6.0"?>
<OpcUaSource FileVersion="10">
  <Aliases>
    <ACLAliases />
    <EURangeViolationAliases />
    <EURangesAliases />
    <EngineeringUnitAliases />
  </Aliases>
  <Module Name="&lt;Default&gt;">
    <GlobalVariables Name="Global Variables">
      <Variable Name="DAxis">
        <Variable Name="Info">
          <Variable Name="JointAxisPosition" RecursiveEnable="2" />
        </Variable>
        <Variable Name="Error" />
        <Variable Name="MoveActive" />
        <Variable Name="X" />
        <Variable Name="Y" />
        <Variable Name="Z" />
      </Variable>
      <Variable Name="U" />
      <Variable Name="V" />
      <Variable Name="W" />
      <Variable Name="DPara">
        <Variable Name="Position" />
      </Variable>
    </GlobalVariables>
    <Task Name="Program">
      <Variable Name="Program" />
      <Variable Name="select" />
      <Variable Name="run" />
      <Variable Name="err" />
      <Variable Name="home" />
    </Task>
  </Module>
</OpcUaSource>